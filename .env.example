# HubSpot: Settings > Integrations > Private Apps. Scopes: crm.objects.contacts.read/write
HUBSPOT_TOKEN=

# Zoho CRM: create a Self Client at api-console.zoho.com, scopes ZohoCRM.modules.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Change for EU/IN/AU data centres, e.g. https://accounts.zoho.eu and https://www.zohoapis.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com

# Optional: rule "notify" actions post here
SLACK_WEBHOOK_URL=
